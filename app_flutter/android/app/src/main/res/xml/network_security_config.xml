<?xml version="1.0" encoding="utf-8"?>
<!--
    Photoview instances are self-hosted, and plenty of them are served over
    plain HTTP on a LAN (e.g. http://192.168.0.47:8080). Android blocks
    cleartext traffic by default, which makes those instances unreachable.
    The user types the instance URL at runtime, so the host cannot be
    allowlisted at build time. The iOS client allowed the same via
    NSAllowsArbitraryLoads.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
